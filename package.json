{
  "name": "@joe-broadhead/opencode-ashby",
  "version": "0.0.1",
  "description": "Unofficial OpenCode plugin for Ashby: find and read your candidates, pipeline, interviews and feedback, and make selected changes, through Ashby's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ashby"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-ashby.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-ashby#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-ashby/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "ashby",
      "name": "Ashby",
      "domain": "ashbyhq.com"
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-ashby-tools.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  },
  "jelly": {
    "title": "Ashby",
    "summary": "Your Ashby candidates, pipeline, interviews and feedback; add a candidate, note or pipeline entry.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "ashby.describe_object_fields",
        "permission": "ashby_describe_object_fields",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.filter_records",
        "permission": "ashby_filter_records",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_candidate",
        "permission": "ashby_get_candidate",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_interview_details",
        "permission": "ashby_get_interview_details",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_interview_plan",
        "permission": "ashby_get_interview_plan",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_job_pipeline",
        "permission": "ashby_get_job_pipeline",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_pending_tasks",
        "permission": "ashby_get_pending_tasks",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_record_details",
        "permission": "ashby_get_record_details",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.get_submitted_feedback",
        "permission": "ashby_get_submitted_feedback",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.list_interviews",
        "permission": "ashby_list_interviews",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.search_product_docs",
        "permission": "ashby_search_product_docs",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.search_records_by_name",
        "permission": "ashby_search_records_by_name",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "ashby.add_note_to_candidate",
        "permission": "ashby_add_note_to_candidate",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "ashby.consider_candidate_for_job",
        "permission": "ashby_consider_candidate_for_job",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "ashby.create_candidate",
        "permission": "ashby_create_candidate",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "ashby.change_application_stage",
        "permission": "ashby_change_application_stage",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "ashby.submit_mcp_feedback",
        "permission": "ashby_submit_mcp_feedback",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "ashby",
      "ashby-write"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "ashby",
        "label": "Ashby",
        "server": "ashby"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  }
}
