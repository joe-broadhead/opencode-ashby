{
  "name": "@we-the-rebel-alliance/ashby-plugin",
  "version": "0.0.9",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "OpenCode plugin for Ashby: your interviews as events, and Ashby's own MCP tools per account",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin-contract",
    "ashby"
  ],
  "license": "MIT",
  "repository": "github:we-the-rebel-alliance/ashby-plugin",
  "homepage": "https://github.com/we-the-rebel-alliance/ashby-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/ashby-plugin/issues"
  },
  "exports": {
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run bundle && git diff --exit-code dist/ && npm run test && npm run conformance && npm run test:pack",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build.mjs",
    "test": "vitest run",
    "conformance": "plugin-kit check",
    "test:pack": "node test/pack/pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/plugin-contract": "github:we-the-rebel-alliance/plugin-contract#v0.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "ashby",
      "title": "Ashby",
      "summary": "Your Ashby interviews, candidates, pipeline and feedback through Ashby's MCP server; change a candidate, note or stage only when asked.",
      "vendor": {
        "id": "ashby",
        "name": "Ashby",
        "domain": "ashbyhq.com"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        },
        {
          "src": "assets/icon-128.png",
          "type": "image/png"
        },
        {
          "src": "assets/icon-256.png",
          "type": "image/png"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "accounts": {
      "via": "mcp",
      "profile": {
        "$ref": "#/options/properties/accounts/additionalProperties"
      },
      "owner": "ashby"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "description": "Reads always run. This decides the rest: all runs every change, ask-changes asks before each one, read-only turns them off."
        },
        "accounts": {
          "type": "object",
          "description": "One profile per account alias. Each alias is its own Ashby MCP server, such as ashby-work.",
          "additionalProperties": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "description": "Start outside the tested OpenCode range."
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "accounts": "none"
      },
      "events_list": {
        "class": "read",
        "accounts": "optional",
        "operations": [
          "list_interviews"
        ]
      },
      "probe": {
        "class": "read",
        "accounts": "optional"
      },
      "mcp:add_note_to_candidate": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "add_note_to_candidate"
        ]
      },
      "mcp:change_application_stage": {
        "class": "send",
        "accounts": "none",
        "operations": [
          "change_application_stage"
        ]
      },
      "mcp:consider_candidate_for_job": {
        "class": "send",
        "accounts": "none",
        "operations": [
          "consider_candidate_for_job"
        ]
      },
      "mcp:create_ai_interviewer": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "create_ai_interviewer"
        ]
      },
      "mcp:create_ai_interviewer_version": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "create_ai_interviewer_version"
        ]
      },
      "mcp:create_candidate": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "create_candidate"
        ]
      },
      "mcp:describe_object_fields": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "describe_object_fields"
        ]
      },
      "mcp:filter_records": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "filter_records"
        ]
      },
      "mcp:get_ai_interviewer_details": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_ai_interviewer_details"
        ]
      },
      "mcp:get_ai_screening_interview_analytics": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_ai_screening_interview_analytics"
        ]
      },
      "mcp:get_ai_screening_interview_results": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_ai_screening_interview_results"
        ]
      },
      "mcp:get_candidate": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_candidate"
        ]
      },
      "mcp:get_interview_details": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_interview_details"
        ]
      },
      "mcp:get_interview_plan": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_interview_plan"
        ]
      },
      "mcp:get_job_pipeline": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_job_pipeline"
        ]
      },
      "mcp:get_pending_tasks": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_pending_tasks"
        ]
      },
      "mcp:get_record_details": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_record_details"
        ]
      },
      "mcp:get_submitted_feedback": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "get_submitted_feedback"
        ]
      },
      "mcp:list_interviews": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "list_interviews"
        ]
      },
      "mcp:search_records_by_name": {
        "class": "read",
        "accounts": "none",
        "operations": [
          "search_records_by_name"
        ]
      },
      "mcp:submit_mcp_feedback": {
        "class": "send",
        "accounts": "none",
        "operations": [
          "submit_mcp_feedback"
        ]
      },
      "mcp:update_ai_interviewer_outline": {
        "class": "write",
        "accounts": "none",
        "operations": [
          "update_ai_interviewer_outline"
        ]
      }
    },
    "sources": [
      {
        "id": "ashby.interviews",
        "kind": "events",
        "reads": "meeting",
        "method": "events_list",
        "input": {
          "source": "ashby"
        },
        "service": {
          "id": "ashby.interviews",
          "label": "Interviews"
        },
        "operations": [
          "list_interviews"
        ],
        "cadence": {
          "suggestMinutes": 2
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      }
    ],
    "actions": [],
    "events": {}
  }
}
